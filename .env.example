# Application Configuration
APP_ENV=development
APP_NAME=voice-vocabulary-platform
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-in-production-super-secret-key-must-be-32-chars

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voice_vocab_db
DATABASE_TEST_URL=sqlite:///./test.db

# Cache & Celery (Redis 7)
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO / S3)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=voice-vocabulary-assets
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_SECURE=false

# Primary Vector Database: Zilliz Cloud / Milvus
MILVUS_URI=https://in03-xxxx.serverless.gcp-us-west1.zillizcloud.com
MILVUS_USER=db_your_username
MILVUS_PASSWORD=your_password
MILVUS_TOKEN=
MILVUS_DATABASE=default

# Fallback Vector Database: Qdrant
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key

# Speech Model: XLS-R 300M
XLSR_MODEL_ID=facebook/wav2vec2-xls-r-300m
XLSR_MODEL_REVISION=main
XLSR_DEVICE=cpu
XLSR_POOLING=masked_mean
EMBEDDING_PIPELINE_VERSION=v1

# AI Providers
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=gsk_your_groq_api_key
GROQ_FALLBACK_API_KEY=gsk_your_fallback_groq_key
GROQ_MODEL=llama-3.3-70b-versatile

# Limits & Thresholds
MAX_UPLOAD_BYTES=20971520
MAX_AUDIO_DURATION_SECONDS=15
RECOGNITION_TOP_K=15
RRF_K=60
CONFIDENCE_ACCEPT_THRESHOLD=0.75
CONFIDENCE_AMBIGUOUS_DELTA=0.08
